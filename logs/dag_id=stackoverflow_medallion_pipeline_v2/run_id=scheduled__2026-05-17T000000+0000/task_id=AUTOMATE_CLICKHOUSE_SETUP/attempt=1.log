(
    id UInt64,
    creation_date DateTime64(3),
    post_type_id UInt8,
    accepted_answer_id Nullable(UInt64),
    parent_id Nullable(UInt64),
    score Int32,
    view_count Nullable(UInt32),
    body String,
    owner_user_id Nullable(Int64),
    owner_display_name Nullable(String),
    last_editor_user_id Nullable(Int64),
    last_editor_display_name Nullable(String),
    last_edit_date Nullable(DateTime64(3)),
    last_activity_date Nullable(DateTime64(3)),
    community_owned_date Nullable(DateTime64(3)),
    closed_date Nullable(DateTime64(3)),
    title Nullable(String),
    tags Nullable(String),
    answer_count Nullable(UInt32),
    comment_count Nullable(UInt32),
    favorite_count Nullable(UInt32)
)
ENGINE = S3Queue('https://bigquerybuckets3.s3.us-east-1.amazonaws.com/raw-data/stackoverflow/*.parquet', Parquet')
SETTINGS mode = 'unordered',
         s3queue_loading_retries = 3,
         role_arn = 'arn:aws:iam::227855914163:role/ClickHouse-S3-ReadOnly-StackOverflow';

CREATE MATERIALIZED VIEW IF NOT EXISTS big_query.stackoverflow_mv
TO big_query.stackoverflow_final
AS
SELECT
    id,
    creation_date,
    post_type_id,
    accepted_answer_id,
    parent_id,
    score,
    view_count,
    body,
    owner_user_id,
