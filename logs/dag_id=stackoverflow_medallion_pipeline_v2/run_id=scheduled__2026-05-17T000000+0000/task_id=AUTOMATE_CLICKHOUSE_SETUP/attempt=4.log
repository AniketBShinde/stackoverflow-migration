CREATE TABLE IF NOT EXISTS big_query.stackoverflow_s3queue
(
    id UInt64,
    creation_date DateTime,
    title String,
    body String,
    accepted_answer_id Nullable(UInt64),
    answer_count Nullable(UInt32),
    comment_count Nullable(UInt32),
    community_owned_date Nullable(DateTime),
    favorite_count Nullable(UInt32),
    last_activity_date Nullable(DateTime),
    last_edit_date Nullable(DateTime),
    last_editor_display_name Nullable(String),
    last_editor_user_id Nullable(UInt64),
    owner_display_name Nullable(String),
    owner_user_id Nullable(UInt64),
    parent_id Nullable(UInt64),
    post_type_id Nullable(UInt8),
    score Nullable(Int32),
    tags Nullable(String),
    view_count Nullable(UInt64)
)
ENGINE = S3Queue('https://bigquerybuckets3.s3.us-east-1.amazonaws.com/raw-data/stackoverflow/*.parquet', Parquet)
SETTINGS mode = 'unordered',
         s3queue_role_arn = 'arn:aws:iam::227855914163:role/ClickHouse-S3-ReadOnly-StackOverflow';

CREATE MATERIALIZED VIEW IF NOT EXISTS big_query.stackoverflow_mv
TO big_query.stackoverflow_final
AS
SELECT *
FROM big_query.stackoverflow_s3queue;
