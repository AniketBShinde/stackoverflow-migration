DESCRIBE TABLE s3('https://bigquerybuckets3.s3.us-east-1.amazonaws.com/raw-data/stackoverflow/*.parquet', 'Parquet', extra_credentials(role_arn = 'arn:aws:iam::227855914163:role/ClickHouse-S3-ReadOnly-StackOverflow'));

CREATE DATABASE IF NOT EXISTS big_query;

CREATE TABLE IF NOT EXISTS big_query.stackoverflow_final
(
    id Int64,
    post_type_id Int32,
    creation_date DateTime64(3),
    last_activity_date Nullable(DateTime64(3)),
    last_edit_date Nullable(DateTime64(3)),
    community_owned_date Nullable(DateTime64(3)),
    closed_date Nullable(DateTime64(3)),
    score Nullable(Int32),
    view_count Nullable(Int32),
    body Nullable(String),
    owner_user_id Nullable(Int64),
    owner_display_name Nullable(String),
    last_editor_user_id Nullable(Int64),
    last_editor_display_name Nullable(String),
    title Nullable(String),
    tags Nullable(String),
    answer_count Nullable(Int32),
    comment_count Nullable(Int32),
    favorite_count Nullable(Int32),
    parent_id Nullable(Int64),
    accepted_answer_id Nullable(Int64)
)
ENGINE = MergeTree
ORDER BY (id, creation_date);

CREATE TABLE IF NOT EXISTS big_query.stackoverflow_queue
(
    id Int64,
    post_type_id Int32,
    creation_date DateTime64(3),
    last_activity_date Nullable(DateTime64(3)),
    last_edit_date Nullable(DateTime64(3)),
    community_owned_date Nullable(DateTime64(3)),
    closed_date Nullable(DateTime64(3)),
    score Nullable(Int32),
    view_count Nullable(Int32),
    body Nullable(String),
    owner_user_id Nullable(Int64),
    owner_display_name Nullable(String),
    last_editor_user_id Nullable(Int64),
    last_editor_display_name Nullable(String),
    title Nullable(String),
    tags Nullable(String),
    answer_count Nullable(Int32),
    comment_count Nullable(Int32),
    favorite_count Nullable(Int32),
    parent_id Nullable(Int64),
    accepted_answer_id Nullable(Int64)
)
ENGINE = S3Queue('https://bigquerybuckets3.s3.us-east-1.amazonaws.com/raw-data/stackoverflow/*.parquet', 'Parquet', extra_credentials(role_arn = 'arn:aws:iam::227855914163:role/ClickHouse-S3-ReadOnly-StackOverflow'))
SETTINGS mode = 'unordered', s3queue_loading_retries = 3;

CREATE MATERIALIZED VIEW IF NOT EXISTS big_query.stackoverflow_mv TO big_query.stackoverflow_final AS
SELECT *
FROM big_query.stackoverflow_queue;

SELECT * FROM big_query.stackoverflow_final ORDER BY creation_date DESC LIMIT 10;

SELECT count() AS row_count FROM big_query.stackoverflow_final;
