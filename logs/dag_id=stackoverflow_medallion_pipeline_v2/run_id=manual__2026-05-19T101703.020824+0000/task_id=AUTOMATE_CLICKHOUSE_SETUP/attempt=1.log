    `owner_display_name` Nullable(String),
    `owner_user_id` Nullable(Int64),
    `parent_id` Nullable(Int64),
    `post_type_id` Nullable(Int8),
    `score` Nullable(Int32),
    `tags` Nullable(String),
    `view_count` Nullable(Int32)
)
ENGINE = S3Queue(
    'https://bigquerybuckets3.s3.us-east-1.amazonaws.com/raw-data/stackoverflow/*.parquet',
    'Parquet',
    extra_credentials(role_arn = 'arn:aws:iam::227855914163:role/ClickHouse-S3-ReadOnly-StackOverflow')
)
SETTINGS mode = 'unordered';

CREATE MATERIALIZED VIEW IF NOT EXISTS big_query.stackoverflow_mv TO big_query.stackoverflow_final AS
SELECT *
FROM big_query.stackoverflow_queue;

SELECT *
FROM big_query.stackoverflow_final
ORDER BY creation_date ASC
LIMIT 10;
